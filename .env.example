# ------------------------------------------------------------------
# AI provider settings (used by app/ai/client.py)
#
# OPENAI (default):
#   AI_API_KEY=sk-xxxx
#   AI_BASE_URL=https://api.openai.com/v1
#
# GROQ (free tier):
#   AI_API_KEY=gsk_xxxx
#   AI_BASE_URL=https://api.groq.com/openai/v1
#
# LOCAL via Ollama (no key needed, free):
#   AI_API_KEY=
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.1
# ------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3