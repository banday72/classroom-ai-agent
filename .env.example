# ------------------------------------------------------------------
# AI provider settings (used by app/ai/client.py)
#
# OPENAI (default):
#   AI_API_KEY=sk-xxxx
#   AI_BASE_URL=https://api.openai.com/v1
#
# GROQ (free tier):
#   AI_API_KEY=gsk_xxxx
#   AI_BASE_URL=https://api.groq.com/openai/v1
#
# LOCAL via Ollama (no key needed, free):
#   AI_API_KEY=
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=qwen2.5:3b
# ------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3

# ------------------------------------------------------------------
# Web UI (app/web.py) — change WEB_PASSWORD before sharing!
# ------------------------------------------------------------------
WEB_PASSWORD=classroom
WEB_PORT=5000
# Optional: where the SQLite DB + downloads live (default: ./data)
# On Vercel/serverless set this to /tmp/classroom-data
# DATA_DIR=/tmp/classroom-data